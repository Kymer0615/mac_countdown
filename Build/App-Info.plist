<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key><string>en</string>
    <key>CFBundleExecutable</key><string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key><string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleInfoDictionaryVersion</key><string>6.0</string>
    <key>CFBundleName</key><string>Countdown Menu Bar</string>
    <key>CFBundlePackageType</key><string>APPL</string>
    <key>CFBundleShortVersionString</key><string>1.3.0</string>
    <key>CFBundleVersion</key><string>4</string>
    <key>LSMinimumSystemVersion</key><string>$(MACOSX_DEPLOYMENT_TARGET)</string>
    <key>NSCalendarsUsageDescription</key><string>Add countdowns to Calendar when you choose, and sync the calendars and events you select into countdowns.</string>
    <key>NSCalendarsFullAccessUsageDescription</key><string>Add countdowns to Calendar when you choose, and sync the calendars and events you select into countdowns. Events are never changed unless you choose Update.</string>
    <key>NSCalendarsWriteOnlyAccessUsageDescription</key><string>Create a Calendar event when you choose Add to Calendar.</string>
    <key>NSRemindersUsageDescription</key><string>Add countdowns to Reminders when you choose, and sync the lists and reminders you select into countdowns.</string>
    <key>NSRemindersFullAccessUsageDescription</key><string>Add countdowns to Reminders when you choose, and sync the lists and reminders you select into countdowns. Reminders are never changed unless you choose Update.</string>
    <key>LSUIElement</key><true/>
    <key>NSHighResolutionCapable</key><true/>
    <key>CFBundleIconFile</key><string>CountdownIcon</string>
    <key>CFBundleURLTypes</key>
    <array><dict>
        <key>CFBundleURLName</key><string>com.local.CountdownMenuBar</string>
        <key>CFBundleURLSchemes</key><array><string>countdownmenubar</string></array>
        <key>CFBundleTypeRole</key><string>Editor</string>
    </dict></array>
</dict>
</plist>
